    <model name="scene2_road">
      <static>true</static>
      <link name="link">
        <visual name="visual"><geometry><mesh><uri>model://scene2_parts/env_road.obj</uri></mesh></geometry><plugin filename="gz-sim-label-system" name="gz::sim::systems::Label"><label>24</label></plugin></visual>
