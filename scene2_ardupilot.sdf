    <model name="scene2_terrain">
      <static>true</static>
      <link name="link">
        <visual name="visual"><geometry><mesh><uri>model://scene2_parts/env_terrain.obj</uri></mesh></geometry><plugin filename="gz-sim-label-system" name="gz::sim::systems::Label"><label>20</label></plugin></visual>
        <collision name="collision"><geometry><mesh><uri>model://scene2_parts/env_terrain.obj</uri></mesh></geometry></collision>
      </link>
