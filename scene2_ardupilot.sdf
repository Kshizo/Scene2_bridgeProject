    <model name="scene2_water">
      <static>true</static>
      <link name="link">
        <visual name="visual"><cast_shadows>false</cast_shadows><geometry><mesh><uri>model://scene2_parts/env_water.obj</uri></mesh></geometry><plugin filename="gz-sim-label-system" name="gz::sim::systems::Label"><label>21</label></plugin></visual>
      </link>
    </model>
    <!-- END generated -->

    <!-- invisible take-off/landing pad on the deck: DART sticks to triangle-mesh contacts, a box is clean -->
    <model name="deck_pad">
      <static>true</static>
      <pose>-3.3 47.5 10.62 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>3 3 0.06</size></box></geometry></collision></link>
    </model>

    <!-- ArduPilot-controlled quad with mapping lidar (SITL connects on UDP 9002). Spawns on the
         deck at mid-span (open sky above), facing along the bridge (+Y). -->
    <include>
      <uri>model://iris_mapper</uri>
      <name>iris</name>
      <pose degrees="true">-3.3 47.5 10.9 0 0 90</pose>
    </include>
  </world>
</sdf>
